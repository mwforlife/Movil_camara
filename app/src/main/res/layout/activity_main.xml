<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/brand_background">
 <ScrollView android:id="@+id/connection_screen" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
   <LinearLayout android:tag="connect_stage" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
    <ImageView android:layout_width="76dp" android:layout_height="76dp" android:src="@drawable/wilkenstech_emblem" android:contentDescription="@string/company_name"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_name" android:gravity="center" android:layout_marginTop="12dp" android:textAppearance="@style/TextAppearance.WT.Title" android:textSize="30sp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/brand_credit" android:gravity="center" android:textAppearance="@style/TextAppearance.WT.Body"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/mobile_welcome" android:textAppearance="@style/TextAppearance.WT.Title" android:gravity="center" android:layout_marginTop="28dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/mobile_welcome_body" android:textAppearance="@style/TextAppearance.WT.Body" android:gravity="center" android:layout_marginTop="8dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:padding="20dp" android:layout_marginTop="24dp" android:background="@drawable/bg_connection_card">
     <ImageView android:layout_width="52dp" android:layout_height="52dp" android:src="@drawable/ic_qr_scan" android:importantForAccessibility="no"/>
     <com.google.android.material.button.MaterialButton android:id="@+id/scan_qr_button" style="@style/Widget.WT.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/scan_qr" android:layout_marginTop="12dp"/>
     <com.google.android.material.button.MaterialButton android:tag="usb_help" style="@style/Widget.WT.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/mobile_usb"/>
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/mobile_computer" android:textAppearance="@style/TextAppearance.WT.Title" android:textSize="18sp" android:layout_marginTop="24dp" android:layout_marginBottom="12dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_connection_card" android:padding="16dp">
     <TextView android:tag="linked_pc" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/mobile_no_pc" android:textColor="@color/brand_text" android:textSize="16sp" android:textStyle="bold"/>
     <com.google.android.material.button.MaterialButton android:tag="prepare_open" style="@style/Widget.WT.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/mobile_prepare" android:enabled="false"/>
    </LinearLayout>
   </LinearLayout>
   <LinearLayout android:tag="prepare_stage" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
    <com.google.android.material.button.MaterialButton android:tag="prepare_back" style="@style/Widget.WT.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/mobile_back"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/mobile_prepare" android:textAppearance="@style/TextAppearance.WT.Title" android:layout_marginTop="12dp"/>
    <TextView android:tag="prepare_pc" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/brand_accent" android:layout_marginTop="8dp" android:layout_marginBottom="20dp" android:textSize="14sp"/>
    <FrameLayout android:tag="prepare_preview_container" android:layout_width="match_parent" android:layout_height="210dp" android:background="@android:color/black" android:layout_marginBottom="16dp">
     <TextureView android:tag="prepare_preview" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/mobile_prepare"/>
     <TextView android:tag="prepare_preview_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:background="#BB0C1220" android:padding="8dp" android:textColor="@color/brand_text" android:textSize="12sp" android:text="@string/camera_preparing"/>
     <com.google.android.material.button.MaterialButton android:tag="preview_permission" style="@style/Widget.WT.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="@string/mobile_enable_preview" android:visibility="gone"/>
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_connection_card" android:padding="18dp">
     <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/camera_choice_label" android:textAppearance="@style/TextAppearance.WT.Body"/>
     <Spinner android:id="@+id/camera_choice" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:popupBackground="@color/brand_surface"/>
     <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/brand_outline" android:layout_marginVertical="12dp"/>
     <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/quality_choice_label" android:textAppearance="@style/TextAppearance.WT.Body"/>
     <Spinner android:id="@+id/quality_profile" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:popupBackground="@color/brand_surface"/>
     <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/mobile_profiles_help" android:textAppearance="@style/TextAppearance.WT.Body" android:textSize="12sp"/>
    </LinearLayout>
    <CheckBox android:id="@+id/send_microphone" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/send_microphone" android:textColor="@color/brand_text" android:buttonTint="@color/brand_accent" android:minHeight="64dp" android:padding="12dp" android:background="@drawable/bg_connection_card" android:layout_marginTop="16dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/mobile_preview_help" android:textAppearance="@style/TextAppearance.WT.Body" android:textSize="12sp" android:layout_marginTop="12dp"/>
    <TextView android:id="@+id/capability_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/loading_capabilities" android:textAppearance="@style/TextAppearance.WT.Body" android:textSize="12sp" android:layout_marginTop="12dp" android:accessibilityLiveRegion="polite"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/start_video_button" style="@style/Widget.WT.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/start_video" android:enabled="false" android:layout_marginTop="20dp"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/capability_details" style="@style/Widget.WT.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/capability_details"/>
   </LinearLayout>
   <TextView android:id="@+id/connection_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/development_status" android:textAppearance="@style/TextAppearance.WT.Body" android:textColor="@color/brand_accent" android:accessibilityLiveRegion="polite" android:layout_marginTop="20dp"/>
   <com.google.android.material.button.MaterialButton android:tag="connection_details_toggle" style="@style/Widget.WT.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/mobile_connection_options"/>
   <LinearLayout android:tag="connection_details" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/network_addresses" android:textAppearance="@style/TextAppearance.WT.Body"/>
    <TextView android:id="@+id/network_addresses" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.WT.Body" android:textIsSelectable="true"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/manual_pair_button" style="@style/Widget.WT.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/manual_pairing"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/disconnect_button" style="@style/Widget.WT.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/disconnect"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/forget_usb_button" style="@style/Widget.WT.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/forget_usb_trust"/>
   </LinearLayout>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/company_name" android:gravity="center" android:textAppearance="@style/TextAppearance.WT.Body" android:layout_marginTop="24dp"/>
  </LinearLayout>
 </ScrollView>
 <include android:id="@+id/camera_panel" layout="@layout/layout_camera" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent"/>
</FrameLayout>