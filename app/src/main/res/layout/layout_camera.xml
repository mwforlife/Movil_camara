<?xml version="1.0" encoding="utf-8"?>
<com.wilkenstech.movilcamara.camera.CameraScreenLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:padding="12dp" android:background="@color/brand_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/app_name" android:textAppearance="@style/TextAppearance.WT.Title" android:textSize="18sp" />
        <TextView android:id="@+id/capture_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:text="@string/camera_preparing" android:textAppearance="@style/TextAppearance.WT.Body" android:textSize="12sp" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@android:color/black">
        <TextureView android:id="@+id/preview_texture" android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <com.wilkenstech.movilcamara.camera.JpegPreviewView android:id="@+id/wifi_preview"
            android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" />
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView android:id="@+id/video_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/video_connecting"
            android:textColor="@color/brand_accent" android:textSize="12sp" android:paddingTop="6dp" android:paddingBottom="4dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/switch_camera_button"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/switch_camera" android:textAllCaps="false" android:textSize="12sp"
                android:minWidth="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:minHeight="48dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/stop_video_button"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="8dp" android:text="@string/stop_video" android:textAllCaps="false"
                android:textSize="12sp" android:minWidth="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:minHeight="48dp" />
        </LinearLayout>
    </LinearLayout>
</com.wilkenstech.movilcamara.camera.CameraScreenLayout>
