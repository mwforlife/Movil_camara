<resources>
    <style name="Widget.WT.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#081522</item>
        <item name="backgroundTint">@color/brand_accent</item>
        <item name="cornerRadius">12dp</item>
    </style>
    <style name="Widget.WT.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/brand_text</item>
        <item name="strokeColor">@color/brand_outline</item>
        <item name="cornerRadius">12dp</item>
    </style>
    <style name="Widget.WT.Danger" parent="Widget.WT.Primary">
        <item name="backgroundTint">#C83746</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>
    <style name="TextAppearance.WT" parent="TextAppearance.MaterialComponents.Body1" />
    <style name="TextAppearance.WT.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/brand_muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="TextAppearance.WT.Title" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textColor">@color/brand_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">24sp</item>
    </style>
</resources>
